    "print(\"\\nSYCOPHANCY COMPARISON\")\n",
    "print(f\"{'Model':<35} {'Rate':>6}\")\n",
    "print(\"-\" * 45)\n",
    "print(f\"{'Claude Haiku — black box':<35} {claude_rate_bb:>6.1%}\")\n",
    "print(f\"{'Claude Haiku — glass box':<35} {claude_rate_gb:>6.1%}\")\n",
